# Server
PORT=3000
NODE_ENV=development
APP_TITLE=MJX Labs · Work Ledger

# Security (generate a long random string in production)
SESSION_SECRET=replace-with-a-long-random-secret-key

# Database (leave blank locally to use SQLite in ./data/worklog.db; set to Postgres URL on Render)
DATABASE_URL=

# Initial Boss Account (optional: if omitted, you can create the Boss account on first visit in the browser)
BOSS_NAME=Internship Lead
BOSS_EMAIL=boss@mjxlabs.com
BOSS_PASSWORD=ChangeMeNow123!

# Team Invite Code (share ONLY with your team so they can create their private accounts)
TEAM_INVITE_CODE=MJX-TEAM-2026
